      "type": "stat",
      "targets": [{ "expr": "sum(dualwrite_experiments_total)", "legendFormat": "", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "auto", "pointSize": 5 },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*Kafka.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*banco.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 7,
      "title": "Lacuna de consistencia (banco vs Kafka)",
      "description": "Divergencia entre escritas no banco e publicacoes no Kafka por cenario — visualizacao do dual-write problem",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (scenario) (dualwrite_orders_total)", "legendFormat": "{{scenario}} — pedidos no banco", "refId": "A" },
        { "expr": "sum by (scenario) (dualwrite_events_published_total)", "legendFormat": "{{scenario}} — eventos no Kafka", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "auto" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 8,
      "title": "Latencia: gravacao no banco",
      "description": "Tempo medio de escrita na tabela orders por cenário",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(dualwrite_db_write_latency_seconds_sum[1m]) / clamp_min(rate(dualwrite_db_write_latency_seconds_count[1m]), 1)", "legendFormat": "{{scenario}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
