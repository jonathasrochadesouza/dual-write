      "id": 9,
      "title": "Latencia: publicacao no Kafka",
      "description": "Tempo medio de envio da mensagem ao Kafka por cenário",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(dualwrite_kafka_publish_latency_seconds_sum[1m]) / clamp_min(rate(dualwrite_kafka_publish_latency_seconds_count[1m]), 1)", "legendFormat": "{{scenario}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 0 },
